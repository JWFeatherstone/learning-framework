# Copy to .env.local (gitignored) and uncomment one provider. With neither, placeholder text.

# Claude Code: your subscription through `claude`, signed in. Plans, writes and grades.
# LF_AUTHOR=claude-code
# LF_PLAN_MODEL=opus
# LF_WRITE_MODEL=sonnet

# Anthropic API: everything, including the seminar tutor, billed per use.
# ANTHROPIC_API_KEY=
# LF_MODEL=claude-opus-5-5

# Where topics live. Default: bank/ at the repo root.
# BANK_DIR=
