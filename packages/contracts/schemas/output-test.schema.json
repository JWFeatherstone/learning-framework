{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
      }
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "free",
              "choice",
              "source"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key": {
            "type": "string"
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "objective",
          "type",
          "prompt"
        ]
      }
    },
    "passing": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "required": [
    "approach",
    "objectives",
    "items"
  ]
}
