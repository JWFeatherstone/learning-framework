{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "form": {
      "type": "string",
      "enum": [
        "dialogue",
        "task"
      ]
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
      }
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "approach",
    "form",
    "objectives",
    "body"
  ]
}
