{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "article",
        "chapter",
        "video",
        "url",
        "primary"
      ]
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "access": {
      "type": "string",
      "enum": [
        "library",
        "owned",
        "open",
        "paywalled",
        "unknown"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "failed"
          ]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "citation",
    "access",
    "verification"
  ]
}
