{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(p\\d+\\.)?c\\d+\\.u\\d+\\/(reading|exercise|test)$"
    },
    "unit": {
      "type": "string",
      "pattern": "^(p\\d+\\.)?c\\d+\\.u\\d+$"
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
      }
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "planVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "inputs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by": {
          "type": "string",
          "enum": ["server", "cli", "human"]
        },
        "cost": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["inputTokens", "outputTokens"]
        },
        "reviewed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["generatedAt", "model", "prompt", "by"]
    },
    "kind": {
      "type": "string",
      "const": "exercise"
    },
    "form": {
      "type": "string",
      "enum": ["dialogue", "task"]
    }
  },
  "required": ["id", "unit", "objectives", "approach", "planVersion", "provenance", "kind", "form"]
}
