{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "estimate": {
      "type": "string"
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
      }
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "newReferences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "book",
              "article",
              "chapter",
              "video",
              "url",
              "primary"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "library",
              "owned",
              "open",
              "paywalled",
              "unknown"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "citation",
          "access"
        ]
      }
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "approach",
    "objectives",
    "body"
  ]
}
