{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "contractsVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "learner": {
      "type": "object",
      "properties": {
        "goals": {
          "type": "string",
          "minLength": 1
        },
        "prior": {
          "type": "string",
          "minLength": 1
        },
        "hoursPerWeek": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "preferences": {
          "type": "string"
        }
      },
      "required": ["goals", "prior"]
    },
    "models": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string"
        },
        "generate": {
          "type": "string"
        },
        "tutor": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        }
      }
    }
  },
  "required": ["id", "title", "created", "contractsVersion", "learner"]
}
