{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "units": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(p\\d+\\.)?c\\d+\\.u\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not-started",
              "in-progress",
              "complete",
              "assessed"
            ]
          },
          "modules": {
            "type": "object",
            "properties": {
              "reading": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "not-started",
                      "in-progress",
                      "complete",
                      "assessed"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "exercise": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "not-started",
                      "in-progress",
                      "complete",
                      "assessed"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "test": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "not-started",
                      "in-progress",
                      "complete",
                      "assessed"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ]
              }
            }
          }
        },
        "required": [
          "state",
          "modules"
        ]
      }
    },
    "mastery": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lastAssessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        },
        "required": [
          "value",
          "lastAssessed"
        ]
      }
    }
  }
}
