{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questions": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "guess": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "guess"
        ]
      }
    }
  },
  "required": [
    "questions"
  ]
}
