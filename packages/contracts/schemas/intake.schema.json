{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "string",
      "minLength": 1
    },
    "prior": {
      "type": "string",
      "minLength": 1
    },
    "hoursPerWeek": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "weeks": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "preferences": {
      "type": "string"
    },
    "sources": {
      "type": "array",
