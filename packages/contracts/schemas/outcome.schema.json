{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "pattern": "^(p\\d+\\.)?c\\d+\\.u\\d+\\/(reading|exercise|test)$"
    },
    "grader": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "objective": {
            "type": "string",
            "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "of": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "objective",
          "score",
          "of"
        ]
      }
    },
    "gaps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "pattern": "^obj\\.[a-z0-9][a-z0-9.-]*$"
          },
          "diagnosis": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        },
        "required": [
          "objective",
          "diagnosis"
        ]
      }
    }
  },
  "required": [
    "session",
    "module",
    "grader",
    "confidence",
    "items"
  ]
}
